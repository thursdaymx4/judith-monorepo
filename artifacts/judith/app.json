{
  "expo": {
    "name": "Judith",
    "slug": "judith",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "judith",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.app.judith",
      "buildNumber": "33",
      "usesAppleSignIn": true,
      "appleTeamId": "88JK8X8BT7",
      "entitlements": {
        "com.apple.developer.icloud-container-identifiers": [
          "iCloud.com.app.judith",
          "iCloud.com.app.judith"
        ],
        "com.apple.developer.ubiquity-container-identifiers": [
          "iCloud.com.app.judith",
          "iCloud.com.app.judith"
        ],
        "com.apple.security.application-groups": [
          "group.com.app.judith",
          "group.com.app.judith"
        ],
        "com.apple.developer.financekit": ["transactions"]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSFinancialDataUsageDescription": "Judith uses your authorized financial transactions to detect bill payments and suggest recurring bills."
      }
    },
    "android": {
      "package": "com.app.judith",
      "versionCode": 33,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon-android-fg.png",
        "backgroundColor": "#0a0b0e"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "updates": {
      "url": "https://u.expo.dev/a0a9f1ab-a9bb-4397-85ee-75138eec8109"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      "expo-updates",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a0b0e",
          "dark": {
            "backgroundColor": "#0a0b0e"
          }
        }
      ],
      "./plugins/with-handled-splash",
      "./plugins/with-judith-app-intents",
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/PlayfairDisplay_800ExtraBold_Italic.ttf"
          ]
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-audio",
        {
          "microphonePermission": "Judith uses the microphone so you can speak your bill questions and dictate new bills hands-free."
        }
      ],
      "expo-notifications",
      "@bacons/apple-targets",
      [
        "@sentry/react-native/expo",
        {
          "organization": "padalastory",
          "project": "judith",
          "disableAutoUpload": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "a0a9f1ab-a9bb-4397-85ee-75138eec8109",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.app.judith.widget",
                  "targetName": "JudithWidget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.app.judith"
                    ]
                  }
                },
                {
                  "bundleIdentifier": "com.app.judith.watchkitapp",
                  "targetName": "JudithWatch",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.app.judith"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
