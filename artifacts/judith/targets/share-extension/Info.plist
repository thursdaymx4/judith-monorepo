<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>CFBundleDisplayName</key>
    <string>Judith</string>
    <key>NSExtension</key>
    <dict>
      <key>NSExtensionAttributes</key>
      <dict>
        <!-- Restrict the share sheet entry to images only (camera-roll
             receipts, Photos sheet, Safari image long-press, screenshot
             share). Without this rule Judith would surface for text, URLs,
             contacts, which is noise the user doesn't want. -->
        <key>NSExtensionActivationRule</key>
        <dict>
          <key>NSExtensionActivationSupportsImageWithMaxCount</key>
          <integer>1</integer>
        </dict>
      </dict>
      <key>NSExtensionPointIdentifier</key>
      <string>com.apple.share-services</string>
      <key>NSExtensionPrincipalClass</key>
      <string>$(PRODUCT_MODULE_NAME).ShareViewController</string>
    </dict>
  </dict>
</plist>
