<?xml version="1.0" encoding="utf-8"?>
<!-- Month-grid bill calendar widget (≈4×4). App pushes updates, so
     updatePeriodMillis=0. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
  android:minWidth="250dp"
  android:minHeight="220dp"
  android:targetCellWidth="4"
  android:targetCellHeight="4"
  android:updatePeriodMillis="0"
  android:initialLayout="@layout/judith_calendar_widget"
  android:previewLayout="@layout/judith_calendar_widget"
  android:resizeMode="horizontal|vertical"
  android:widgetCategory="home_screen"
  android:description="@string/judith_calendar_widget_description" />
