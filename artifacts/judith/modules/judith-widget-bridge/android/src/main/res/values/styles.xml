<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- A single day cell in the calendar widget grid. -->
  <style name="JudithCalCell">
    <item name="android:layout_width">0dp</item>
    <item name="android:layout_height">28dp</item>
    <item name="android:layout_weight">1</item>
    <item name="android:layout_margin">1dp</item>
    <item name="android:gravity">center</item>
    <item name="android:textSize">11sp</item>
    <item name="android:textColor">#A7ADBA</item>
    <item name="android:fontFamily">sans-serif</item>
  </style>

  <!-- Weekday header letter (S M T W T F S). -->
  <style name="JudithCalHead">
    <item name="android:layout_width">0dp</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:layout_weight">1</item>
    <item name="android:gravity">center</item>
    <item name="android:textSize">9sp</item>
    <item name="android:textColor">#6A7180</item>
    <item name="android:fontFamily">sans-serif-medium</item>
    <item name="android:letterSpacing">0.05</item>
  </style>
</resources>
