<?xml version="1.0" encoding="utf-8"?>
<!--
  Branded RemoteViews widget (LinearLayout/TextView/ImageView/ProgressBar only).
  Bound by JudithWidgetProvider. Layout:
    header   → Judith mark + wordmark + unpaid-count chip
    hero     → "DUE THIS MONTH" + total + paid-this-month bar
    next row → provider avatar tile + name/due + amount (urgency colour)
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/judith_widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:background="@drawable/judith_widget_bg"
  android:padding="15dp">

  <!-- Header -->
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <ImageView
      android:id="@+id/judith_widget_logo"
      android:layout_width="22dp"
      android:layout_height="22dp"
      android:scaleType="fitCenter"
      android:contentDescription="Judith" />

    <TextView
      android:id="@+id/judith_widget_brand"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:layout_marginStart="8dp"
      android:text="JUDITH"
      android:textColor="#29D5A5"
      android:textSize="13sp"
      android:textStyle="bold"
      android:fontFamily="sans-serif-medium"
      android:letterSpacing="0.14" />

    <TextView
      android:id="@+id/judith_widget_count"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:background="@drawable/judith_widget_pill"
      android:paddingStart="9dp"
      android:paddingEnd="9dp"
      android:paddingTop="3dp"
      android:paddingBottom="3dp"
      android:text=""
      android:textColor="#A7ADBA"
      android:textSize="11sp"
      android:fontFamily="sans-serif-medium" />
  </LinearLayout>

  <!-- Hero amount -->
  <TextView
    android:id="@+id/judith_widget_due_label"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="13dp"
    android:text="DUE THIS MONTH"
    android:textColor="#6A7180"
    android:textSize="9sp"
    android:letterSpacing="0.1"
    android:fontFamily="sans-serif-medium" />

  <TextView
    android:id="@+id/judith_widget_total"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="1dp"
    android:text="—"
    android:textColor="#F3F5F8"
    android:textSize="28sp"
    android:textStyle="bold"
    android:fontFamily="sans-serif" />

  <!-- Paid-this-month progress -->
  <ProgressBar
    android:id="@+id/judith_widget_progress"
    style="@android:style/Widget.ProgressBar.Horizontal"
    android:layout_width="match_parent"
    android:layout_height="5dp"
    android:layout_marginTop="9dp"
    android:max="100"
    android:progress="0"
    android:indeterminate="false"
    android:progressDrawable="@drawable/judith_widget_progress" />

  <!-- Next bill -->
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginTop="13dp">

    <TextView
      android:id="@+id/judith_widget_avatar"
      android:layout_width="30dp"
      android:layout_height="30dp"
      android:background="@drawable/judith_widget_avatar"
      android:gravity="center"
      android:text=""
      android:textColor="#29D5A5"
      android:textSize="14sp"
      android:textStyle="bold"
      android:fontFamily="sans-serif-medium" />

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:layout_marginStart="10dp"
      android:orientation="vertical">

      <TextView
        android:id="@+id/judith_widget_next_provider"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:text=""
        android:textColor="#F3F5F8"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium" />

      <TextView
        android:id="@+id/judith_widget_next_due"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text=""
        android:textColor="#A7ADBA"
        android:textSize="11sp"
        android:fontFamily="sans-serif" />
    </LinearLayout>

    <TextView
      android:id="@+id/judith_widget_next_amount"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text=""
      android:textColor="#29D5A5"
      android:textSize="15sp"
      android:textStyle="bold"
      android:fontFamily="sans-serif-medium" />
  </LinearLayout>
</LinearLayout>
