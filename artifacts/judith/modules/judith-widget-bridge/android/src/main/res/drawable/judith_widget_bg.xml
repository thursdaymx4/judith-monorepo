<?xml version="1.0" encoding="utf-8"?>
<!--
  Branded card: a subtle mint-tinted dark gradient (not a flat black slab) with
  a faint accent hairline border. Mirrors the app canvas/surfaces from
  constants/theme.ts (#0E1018 canvas, #29D5A5 accent).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
  <gradient
    android:type="linear"
    android:angle="135"
    android:startColor="#16241F"
    android:centerColor="#111722"
    android:endColor="#0E1018" />
  <corners android:radius="24dp" />
  <stroke android:width="1dp" android:color="#2629D5A5" />
</shape>
